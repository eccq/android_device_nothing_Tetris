+    private static FontCustomizationParser.Result parseCustomization(@Nullable String path,
+            @Nullable String productFontDir, @Nullable Map<String, File> updatableFontMap)
+            throws XmlPullParserException {
+        if (path == null) return new FontCustomizationParser.Result();
+        try (InputStream is = new FileInputStream(path)) {
+            return FontCustomizationParser.parse(is, productFontDir, updatableFontMap);
