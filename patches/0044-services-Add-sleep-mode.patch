diff --git a/services/core/java/com/android/server/power/SleepModeController.java b/services/core/java/com/android/server/power/SleepModeController.java
new file mode 100644
index 000000000000..d46474ae3b4b
--- /dev/null
+++ b/services/core/java/com/android/server/power/SleepModeController.java
@@ -0,0 +1,225 @@
+/*
+ * Copyright (C) 2021 Havoc-OS
+ * Copyright (C) 2024-2026 Lunaris AOSP
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.server.power;
+
+import android.app.Notification;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.bluetooth.BluetoothAdapter;
+import android.bluetooth.BluetoothManager;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.database.ContentObserver;
+import android.hardware.SensorPrivacyManager;
+import android.media.AudioManager;
+import android.net.Uri;
+import android.net.wifi.WifiManager;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.telephony.SubscriptionManager;
+import android.telephony.TelephonyManager;
+import android.util.Slog;
+
+import com.android.internal.R;
+import com.android.internal.notification.SystemNotificationChannels;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/** Turns radios, sensors and the ringer off in sleep mode and back on after it. */
+class SleepModeController {
+
+    private static final String TAG = "SleepModeController";
+    private static final String ACTION_TURN_OFF = "com.android.server.power.SLEEP_MODE_TURN_OFF";
+    private static final int NOTIFICATION_ID = 727;
+
+    private final Context mContext;
+    private final NotificationManager mNotificationManager;
+
+    SleepModeController(Context context) {
+        mContext = context;
+        mNotificationManager = context.getSystemService(NotificationManager.class);
+
+        HandlerThread thread = new HandlerThread(TAG);
+        thread.start();
+        Handler handler = new Handler(thread.getLooper());
+        context.getContentResolver().registerContentObserver(
+                Settings.Secure.getUriFor(Settings.Secure.SLEEP_MODE_ENABLED), false,
+                new ContentObserver(handler) {
+                    @Override
+                    public void onChange(boolean selfChange, Uri uri) {
+                        update();
+                    }
+                }, UserHandle.USER_ALL);
+        context.registerReceiver(new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context c, Intent intent) {
+                putInt(Settings.Secure.SLEEP_MODE_ENABLED, 0);
+            }
+        }, new IntentFilter(ACTION_TURN_OFF), null, handler, Context.RECEIVER_NOT_EXPORTED);
+        handler.post(this::update);
+    }
+
+    private void update() {
+        boolean enabled = getInt(Settings.Secure.SLEEP_MODE_ENABLED, 0) == 1;
+        // The saved state survives a reboot, so it tells whether sleep mode was applied.
+        String saved = Settings.Secure.getStringForUser(mContext.getContentResolver(),
+                Settings.Secure.SLEEP_MODE_SAVED_STATE, UserHandle.USER_CURRENT);
+        boolean applied = saved != null && !saved.isEmpty();
+        if (enabled && !applied) {
+            enable();
+        } else if (!enabled && applied) {
+            disable(saved);
+        }
+        if (enabled) {
+            showNotification();
+        } else {
+            mNotificationManager.cancel(NOTIFICATION_ID);
+        }
+    }
+
+    private void enable() {
+        WifiManager wifi = mContext.getSystemService(WifiManager.class);
+        BluetoothAdapter bluetooth = bluetooth();
+        TelephonyManager telephony = telephony();
+        SensorPrivacyManager sensors = mContext.getSystemService(SensorPrivacyManager.class);
+        AudioManager audio = mContext.getSystemService(AudioManager.class);
+
+        boolean wifiOff = isOn(Settings.Secure.SLEEP_MODE_WIFI_TOGGLE) && wifi != null
+                && wifi.isWifiEnabled();
+        boolean bluetoothOff = isOn(Settings.Secure.SLEEP_MODE_BLUETOOTH_TOGGLE)
+                && bluetooth != null && bluetooth.isEnabled();
+        boolean dataOff = isOn(Settings.Secure.SLEEP_MODE_CELLULAR_TOGGLE)
+                && telephony != null && telephony.isDataEnabled();
+        boolean sensorsOff = isOn(Settings.Secure.SLEEP_MODE_SENSORS_TOGGLE)
+                && sensors != null && !sensors.isAllSensorPrivacyEnabled();
+        int ringer = audio == null ? 0 : getInt(Settings.Secure.SLEEP_MODE_RINGER_MODE, 0);
+
+        // Saved first: a crash halfway still restores everything.
+        JSONObject saved = new JSONObject();
+        try {
+            saved.put("wifi", wifiOff);
+            saved.put("bluetooth", bluetoothOff);
+            saved.put("data", dataOff);
+            saved.put("sub", dataOff ? telephony.getSubscriptionId() : -1);
+            saved.put("sensors", sensorsOff);
+            if (ringer != 0) {
+                saved.put("ringer", audio.getRingerModeInternal());
+                saved.put("zen", mNotificationManager.getZenMode());
+            }
+        } catch (JSONException e) {
+            Slog.e(TAG, "Cannot save the state", e);
+            return;
+        }
+        putString(saved.toString());
+
+        if (wifiOff) attempt(() -> wifi.setWifiEnabled(false));
+        if (bluetoothOff) attempt(bluetooth::disable);
+        if (dataOff) attempt(() -> telephony.setDataEnabled(false));
+        if (sensorsOff) attempt(() -> sensors.setAllSensorPrivacy(true));
+        if (ringer != 0) {
+            attempt(() -> {
+                int mode = ringer == 1 ? AudioManager.RINGER_MODE_VIBRATE
+                        : ringer == 2 ? AudioManager.RINGER_MODE_NORMAL
+                        : AudioManager.RINGER_MODE_SILENT;
+                audio.setRingerModeInternal(mode);
+                mNotificationManager.setZenMode(ringer == 2
+                        ? Settings.Global.ZEN_MODE_IMPORTANT_INTERRUPTIONS
+                        : Settings.Global.ZEN_MODE_OFF, null, TAG);
+            });
+        }
+    }
+
+    private void disable(String json) {
+        JSONObject saved;
+        try {
+            saved = new JSONObject(json);
+        } catch (JSONException e) {
+            Slog.e(TAG, "Cannot read the saved state", e);
+            putString("");
+            return;
+        }
+        if (saved.optBoolean("wifi")) {
+            attempt(() -> mContext.getSystemService(WifiManager.class).setWifiEnabled(true));
+        }
+        if (saved.optBoolean("bluetooth")) attempt(() -> bluetooth().enable());
+        if (saved.optBoolean("data")) {
+            attempt(() -> mContext.getSystemService(TelephonyManager.class)
+                    .createForSubscriptionId(saved.optInt("sub",
+                            SubscriptionManager.getDefaultDataSubscriptionId()))
+                    .setDataEnabled(true));
+        }
+        if (saved.optBoolean("sensors")) {
+            attempt(() -> mContext.getSystemService(SensorPrivacyManager.class)
+                    .setAllSensorPrivacy(false));
+        }
+        if (saved.has("ringer")) {
+            attempt(() -> {
+                mContext.getSystemService(AudioManager.class)
+                        .setRingerModeInternal(saved.optInt("ringer"));
+                mNotificationManager.setZenMode(saved.optInt("zen"), null, TAG);
+            });
+        }
+        putString("");
+    }
+
+    private BluetoothAdapter bluetooth() {
+        BluetoothManager manager = mContext.getSystemService(BluetoothManager.class);
+        return manager == null ? null : manager.getAdapter();
+    }
+
+    private TelephonyManager telephony() {
+        TelephonyManager manager = mContext.getSystemService(TelephonyManager.class);
+        return manager == null ? null : manager.createForSubscriptionId(
+                SubscriptionManager.getDefaultDataSubscriptionId());
+    }
+
+    private void attempt(Runnable action) {
+        try {
+            action.run();
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "Sleep mode step failed", e);
+        }
+    }
+
+    private void showNotification() {
+        PendingIntent turnOff = PendingIntent.getBroadcast(mContext, 0,
+                new Intent(ACTION_TURN_OFF).setPackage(mContext.getPackageName()),
+                PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
+        mNotificationManager.notify(NOTIFICATION_ID,
+                new Notification.Builder(mContext, SystemNotificationChannels.NETWORK_STATUS)
+                        .setContentTitle(mContext.getString(R.string.sleep_mode_notification_title))
+                        .setContentText(mContext.getString(R.string.sleep_mode_notification_content))
+                        .setSmallIcon(R.drawable.ic_zen_24dp)
+                        .setOngoing(true)
+                        .setContentIntent(turnOff)
+                        .build());
+    }
+
+    private boolean isOn(String key) {
+        return getInt(key, 1) == 1;
+    }
+
+    private int getInt(String key, int def) {
+        return Settings.Secure.getIntForUser(mContext.getContentResolver(), key, def,
+                UserHandle.USER_CURRENT);
+    }
+
+    private void putInt(String key, int value) {
+        Settings.Secure.putIntForUser(mContext.getContentResolver(), key, value,
+                UserHandle.USER_CURRENT);
+    }
+
+    private void putString(String value) {
+        Settings.Secure.putStringForUser(mContext.getContentResolver(),
+                Settings.Secure.SLEEP_MODE_SAVED_STATE, value, UserHandle.USER_CURRENT);
+    }
+}
