+/*
+ * Copyright (C) 2024-2026 Lunaris AOSP
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.systemui.lunaris;
+
+import android.app.AlarmManager;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.provider.Settings;
+import android.provider.Telephony;
+import android.telecom.TelecomManager;
+
+import java.util.HashSet;
+import java.util.Set;
+
+final class LunarisIdleConstants {
+
+    private LunarisIdleConstants() {}
+
+    /** User apps the phone depends on right now: keyboard, dialer, messages, next alarm. */
+    static Set<String> protectedPackages(Context context) {
+        Set<String> out = new HashSet<>();
+        out.add("com.whatsapp");
+        String ime = Settings.Secure.getString(context.getContentResolver(),
+                Settings.Secure.DEFAULT_INPUT_METHOD);
+        ComponentName imeName = ime == null ? null : ComponentName.unflattenFromString(ime);
+        if (imeName != null) out.add(imeName.getPackageName());
+        out.add(Telephony.Sms.getDefaultSmsPackage(context));
+        TelecomManager telecom = context.getSystemService(TelecomManager.class);
+        if (telecom != null) out.add(telecom.getDefaultDialerPackage());
+        AlarmManager alarms = context.getSystemService(AlarmManager.class);
+        AlarmManager.AlarmClockInfo next = alarms == null ? null : alarms.getNextAlarmClock();
+        if (next != null && next.getShowIntent() != null) {
+            out.add(next.getShowIntent().getCreatorPackage());
+        }
+        return out;
+    }
+
+    static boolean isSystemApp(PackageManager pm, String pkg) {
+        try {
+            return (pm.getApplicationInfo(pkg, 0).flags & ApplicationInfo.FLAG_SYSTEM) != 0;
+        } catch (PackageManager.NameNotFoundException e) {
+            return true;
+        }
+    }
+}
