+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.fuelgauge.idlemanager;
+
+import android.app.settings.SettingsEnums;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.graphics.drawable.Drawable;
+import android.os.Bundle;
+import android.provider.Settings;
+import android.util.Log;
+
+import androidx.preference.ListPreference;
+import androidx.preference.PreferenceCategory;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settingslib.search.SearchIndexable;
+import com.android.settingslib.utils.ThreadUtils;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+
+/** What the SystemUI idle manager does to each user app while the screen is off. */
+@SearchIndexable(forTarget = SearchIndexable.ALL & ~SearchIndexable.ARC)
+public class IdleManagerSettings extends SettingsPreferenceFragment {
+
+    private static final String TAG = "IdleManagerSettings";
+
+    private record App(String pkg, CharSequence label, Drawable icon) {}
+
+    private final Map<String, String> mRules = new TreeMap<>();
+
+    @Override
+    public void onCreate(Bundle bundle) {
+        super.onCreate(bundle);
+        addPreferencesFromResource(R.xml.idle_manager_settings);
+        loadRules();
+        PackageManager pm = getContext().getPackageManager();
+        ThreadUtils.postOnBackgroundThread(() -> {
+            List<App> apps = new ArrayList<>();
+            for (ApplicationInfo info : pm.getInstalledApplications(0)) {
+                if ((info.flags & ApplicationInfo.FLAG_SYSTEM) == 0) {
+                    apps.add(new App(info.packageName, info.loadLabel(pm), info.loadIcon(pm)));
+                }
+            }
+            apps.sort((a, b) -> a.label.toString().compareToIgnoreCase(b.label.toString()));
+            ThreadUtils.postOnMainThread(() -> showApps(apps));
+        });
+    }
+
+    private void showApps(List<App> apps) {
+        PreferenceCategory list = findPreference("idle_manager_app_list");
+        if (!isAdded() || list == null) return;
+        JSONObject stats = stats();
+        for (App app : apps) {
+            ListPreference pref = new ListPreference(list.getContext());
+            pref.setKey("idle_app_" + app.pkg);
+            pref.setPersistent(false);
+            pref.setTitle(app.label);
+            pref.setIcon(app.icon);
+            pref.setDialogTitle(app.label);
+            pref.setEntries(R.array.idle_manager_entries);
+            pref.setEntryValues(R.array.idle_manager_values);
+            pref.setValue(mRules.getOrDefault(app.pkg, ""));
+            JSONObject stat = stats.optJSONObject(app.pkg);
+            int count = stat == null ? 0 : stat.optInt("count");
+            pref.setSummaryProvider(p -> {
+                CharSequence entry = ((ListPreference) p).getEntry();
+                return count == 0 ? entry
+                        : entry + " · " + getString(R.string.idle_manager_count, count);
+            });
+            pref.setOnPreferenceChangeListener((p, value) -> {
+                saveRule(app.pkg, (String) value);
+                return true;
+            });
+            list.addPreference(pref);
+        }
+    }
+
+    private void loadRules() {
+        String json = Settings.Secure.getString(getContext().getContentResolver(),
+                Settings.Secure.IDLE_MANAGER_APPS);
+        if (json == null || json.isEmpty()) return;
+        try {
+            JSONArray rules = new JSONArray(json);
+            for (int i = 0; i < rules.length(); i++) {
+                JSONObject rule = rules.getJSONObject(i);
+                mRules.put(rule.getString("package"), rule.getString("action"));
+            }
+        } catch (JSONException e) {
+            Log.e(TAG, "Cannot read the rules", e);
+        }
+    }
+
+    private void saveRule(String pkg, String action) {
+        if (action.isEmpty()) {
+            mRules.remove(pkg);
+        } else {
+            mRules.put(pkg, action);
+        }
+        JSONArray rules = new JSONArray();
+        try {
+            for (Map.Entry<String, String> rule : mRules.entrySet()) {
+                rules.put(new JSONObject()
+                        .put("package", rule.getKey())
+                        .put("action", rule.getValue()));
+            }
+        } catch (JSONException e) {
+            Log.e(TAG, "Cannot write the rules", e);
+            return;
+        }
+        Settings.Secure.putString(getContext().getContentResolver(),
+                Settings.Secure.IDLE_MANAGER_APPS, rules.toString());
+    }
+
+    private JSONObject stats() {
+        String json = Settings.Secure.getString(getContext().getContentResolver(),
+                Settings.Secure.IDLE_MANAGER_KILL_STATS);
+        try {
+            return json == null || json.isEmpty() ? new JSONObject() : new JSONObject(json);
+        } catch (JSONException e) {
+            return new JSONObject();
+        }
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.OPEN_BATTERY_ADAPTIVE_PREFERENCES;
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(R.xml.idle_manager_settings);
+}
diff --git a/src/com/android/settings/fuelgauge/sleepmode/SleepModeSettings.java b/src/com/android/settings/fuelgauge/sleepmode/SleepModeSettings.java
