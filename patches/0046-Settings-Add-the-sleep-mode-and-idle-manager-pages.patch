+++ b/src/com/android/settings/fuelgauge/sleepmode/SleepModeSettings.java
@@ -0,0 +1,158 @@
+/*
+ * Copyright (C) 2021 Havoc-OS
+ * Copyright (C) 2026 Descartes OS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.fuelgauge.sleepmode;
+
+import android.app.TimePickerDialog;
+import android.app.settings.SettingsEnums;
+import android.content.ContentResolver;
+import android.database.ContentObserver;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.text.format.DateFormat;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.TwoStatePreference;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settingslib.search.SearchIndexable;
+
+import java.time.LocalTime;
+import java.time.format.DateTimeFormatter;
+import java.time.format.DateTimeParseException;
+import java.util.Locale;
+
+/** Sleep mode switch, schedule and what it turns off. */
+@SearchIndexable(forTarget = SearchIndexable.ALL & ~SearchIndexable.ARC)
+public class SleepModeSettings extends SettingsPreferenceFragment {
+
+    private static final String DEFAULT_TIMES = "22:00,07:00";
+
+    private final ContentObserver mObserver =
+            new ContentObserver(new Handler(Looper.getMainLooper())) {
+                @Override
+                public void onChange(boolean selfChange, Uri uri) {
+                    refresh();
+                }
+            };
+
+    private TwoStatePreference mEnabled;
+    private ListPreference mMode;
+    private Preference mSince;
+    private Preference mTill;
+    private Preference mToggles;
+
+    @Override
+    public void onCreate(Bundle bundle) {
+        super.onCreate(bundle);
+        addPreferencesFromResource(R.xml.sleep_mode_settings);
+        mEnabled = findPreference("sleep_mode_enabled");
+        mMode = findPreference("sleep_mode_auto_mode");
+        mSince = findPreference("sleep_mode_since");
+        mTill = findPreference("sleep_mode_till");
+        mToggles = findPreference("sleep_mode_toggles");
+
+        mEnabled.setOnPreferenceChangeListener((p, value) -> {
+            putInt(Settings.Secure.SLEEP_MODE_ENABLED, (Boolean) value ? 1 : 0);
+            return true;
+        });
+        mMode.setOnPreferenceChangeListener((p, value) -> {
+            putInt(Settings.Secure.SLEEP_MODE_AUTO_MODE, Integer.parseInt((String) value));
+            return true;
+        });
+        mSince.setOnPreferenceClickListener(p -> pickTime(0));
+        mTill.setOnPreferenceClickListener(p -> pickTime(1));
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        for (String key : new String[] {
+                Settings.Secure.SLEEP_MODE_ENABLED,
+                Settings.Secure.SLEEP_MODE_AUTO_MODE,
+                Settings.Secure.SLEEP_MODE_AUTO_TIME}) {
+            resolver().registerContentObserver(Settings.Secure.getUriFor(key), false, mObserver,
+                    UserHandle.USER_CURRENT);
+        }
+        refresh();
+    }
+
+    @Override
+    public void onPause() {
+        resolver().unregisterContentObserver(mObserver);
+        super.onPause();
+    }
+
+    private void refresh() {
+        boolean on = getInt(Settings.Secure.SLEEP_MODE_ENABLED) == 1;
+        int mode = getInt(Settings.Secure.SLEEP_MODE_AUTO_MODE);
+        mEnabled.setChecked(on);
+        mMode.setValue(String.valueOf(mode));
+        mSince.setVisible(mode == 2 || mode == 4);
+        mTill.setVisible(mode == 2 || mode == 3);
+        DateTimeFormatter format = DateTimeFormatter.ofPattern(
+                DateFormat.is24HourFormat(getContext()) ? "HH:mm" : "h:mm a");
+        LocalTime[] times = times();
+        mSince.setSummary(times[0].format(format));
+        mTill.setSummary(times[1].format(format));
+        // Changing them midway would not match what is already off.
+        mToggles.setEnabled(!on);
+    }
+
+    private boolean pickTime(int index) {
+        LocalTime[] times = times();
+        new TimePickerDialog(getContext(), (view, hour, minute) -> {
+            times[index] = LocalTime.of(hour, minute);
+            Settings.Secure.putStringForUser(resolver(), Settings.Secure.SLEEP_MODE_AUTO_TIME,
+                    String.format(Locale.ROOT, "%s,%s", times[0], times[1]),
+                    UserHandle.USER_CURRENT);
+        }, times[index].getHour(), times[index].getMinute(),
+                DateFormat.is24HourFormat(getContext())).show();
+        return true;
+    }
+
+    private LocalTime[] times() {
+        String value = Settings.Secure.getStringForUser(resolver(),
+                Settings.Secure.SLEEP_MODE_AUTO_TIME, UserHandle.USER_CURRENT);
+        try {
+            String[] parts = value == null ? new String[0] : value.split(",");
+            if (parts.length == 2) {
+                return new LocalTime[] {LocalTime.parse(parts[0]), LocalTime.parse(parts[1])};
+            }
+        } catch (DateTimeParseException e) {
+            // Falls back to the default times.
+        }
+        String[] parts = DEFAULT_TIMES.split(",");
+        return new LocalTime[] {LocalTime.parse(parts[0]), LocalTime.parse(parts[1])};
+    }
+
+    private ContentResolver resolver() {
+        return getContext().getContentResolver();
+    }
+
+    private int getInt(String key) {
+        return Settings.Secure.getIntForUser(resolver(), key, 0, UserHandle.USER_CURRENT);
+    }
+
+    private void putInt(String key, int value) {
+        Settings.Secure.putIntForUser(resolver(), key, value, UserHandle.USER_CURRENT);
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.OPEN_BATTERY_SAVER;
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(R.xml.sleep_mode_settings);
+}
