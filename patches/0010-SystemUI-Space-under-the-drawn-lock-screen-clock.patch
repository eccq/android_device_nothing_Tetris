+
+    override fun onLayout(changed: Boolean, l: Int, t: Int, r: Int, b: Int) {
+        super.onLayout(changed, l, t, r, b)
+        post { updateOverflowPadding() }
+    }
+
+    // The keyguard places the media card and notifications under this view's measured bottom,
+    // but negative margins and the size scale draw parts of many clocks below it.
+    private fun updateOverflowPadding() {
+        val view = currentClockView
+        val overflow =
+            if (forHome || view == null || view.visibility != View.VISIBLE) 0
+            else (drawnBottom(view) - (height - paddingBottom)).coerceAtLeast(0)
+        if (overflow != paddingBottom) setPadding(paddingLeft, paddingTop, paddingRight, overflow)
+    }
+
+    private fun drawnBottom(clock: View): Int {
+        var top = 0
+        var v: View = clock
+        while (v !== this) {
+            top += v.top
+            v = v.parent as? View ?: return 0
+        }
+        // The AOD scale-down is left out so the content below does not move when dozing.
+        return top + (contentBottom(clock) * getScaleFactor()).toInt()
+    }
+
+    private fun contentBottom(view: View): Int {
+        var bottom = view.height
+        if (view is ViewGroup) {
+            for (i in 0 until view.childCount) {
+                val child = view.getChildAt(i)
+                if (child.visibility == View.VISIBLE) {
+                    bottom = maxOf(bottom, child.top + contentBottom(child))
+                }
+            }
+        }
+        return bottom
+    }
