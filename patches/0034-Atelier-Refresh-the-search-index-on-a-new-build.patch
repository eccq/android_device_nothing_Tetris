+package com.crdroid.settings
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.SystemProperties
+import android.util.Log
+
+/**
+ * Settings search only rebuilds its index when the build fingerprint or the providers' version
+ * codes change, and both stay the same between our builds. Wipe the index once per build so
+ * every page, Atelier included, is indexed again on the next search.
+ */
+class SearchIndexRefreshReceiver : BroadcastReceiver() {
+
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action != Intent.ACTION_BOOT_COMPLETED) return
+        val build = SystemProperties.get("ro.build.version.incremental")
+        val prefs = context.createDeviceProtectedStorageContext()
+            .getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        if (build.isEmpty() || prefs.getString(KEY_BUILD, null) == build) return
+        val pm = context.packageManager
+        for (pkg in SEARCH_PACKAGES) {
+            try {
+                pm.getPackageInfo(pkg, 0)
+                pm.clearApplicationUserData(pkg, null)
+                Log.i(TAG, "Cleared the search index of $pkg for build $build")
+            } catch (e: PackageManager.NameNotFoundException) {
+                // Not installed on this build.
+            }
+        }
+        prefs.edit().putString(KEY_BUILD, build).apply()
+    }
+
+    private companion object {
+        const val TAG = "SearchIndexRefresh"
+        const val PREFS = "search_index_refresh"
+        const val KEY_BUILD = "indexed_build"
+        val SEARCH_PACKAGES = listOf(
+            "com.android.settings.intelligence",
+            "com.google.android.settings.intelligence",
+        )
+    }
+}
