+package com.android.systemui.statusbar.quickactions.ui.compose
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.drawBehind
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.geometry.Rect
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.Path
+import androidx.compose.ui.graphics.PathOperation
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.unit.dp
+import com.android.systemui.statusbar.quickactions.popups.shared.DynamicIslandFeatureSettings
+
+/** PenguinOS' pill, drawn on the stock island. */
+internal object PenguinIsland {
+    val MinHeight = 30.dp
+    val TextColor = Color(0xE6FFFFFF)
+    val StrokeWidth = 1.3.dp
+    val StrokeColor = Color(0x40959595)
+    val MoonWidth = 4.dp
+    val MoonGap = 2.dp
+    val MoonColor = Color(0xE64A4A4A)
+}
+
+@Composable
+internal fun rememberPenguinLook(): Boolean {
+    val context = LocalContext.current
+    val on by
+        remember {
+                DynamicIslandFeatureSettings.observeDynamicIslandFeatureEnabled(
+                    context,
+                    DynamicIslandFeatureSettings.PENGUIN_LOOK,
+                    defaultValue = false,
+                )
+            }
+            .collectAsState(initial = false)
+    return on
+}
+
+/** A crescent on each side of the pill: there are more chips to swipe to. */
+internal fun Modifier.penguinMoons(visible: Boolean): Modifier =
+    if (!visible) this
+    else
+        drawBehind {
+            val r = size.height / 2f
+            val gap = PenguinIsland.MoonGap.toPx()
+            val reach = gap + PenguinIsland.MoonWidth.toPx()
+            for (side in listOf(-1f, 1f)) {
+                val edge = if (side < 0) r else size.width - r
+                val inner = Path().apply { addOval(Rect(Offset(edge + side * gap, r), r)) }
+                val outer = Path().apply { addOval(Rect(Offset(edge + side * reach, r), r)) }
+                val moon = Path().apply { op(outer, inner, PathOperation.Difference) }
+                drawPath(moon, PenguinIsland.MoonColor)
+            }
+        }
