+package com.android.systemui.lunaris.island.seekbar
+
+import android.content.res.ColorStateList
+import android.graphics.Color
+import android.graphics.drawable.Drawable
+import android.view.View
+import android.widget.SeekBar
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.key
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberUpdatedState
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.viewinterop.AndroidView
+import com.android.systemui.lunaris.island.seekbar.MediaSeekBarStyle
+import com.android.systemui.media.controls.ui.drawable.SquigglyProgress
+import com.android.systemui.lunaris.island.seekbar.CometTrailSeekBar
+import com.android.systemui.lunaris.island.seekbar.CosSeekBar
+import com.android.systemui.lunaris.island.seekbar.GlowingSeekBar
+import com.android.systemui.lunaris.island.seekbar.GradientWaveSeekBar
+import com.android.systemui.media.controls.ui.view.WaveformSeekBar
+import com.android.systemui.res.R
+
+@Composable
+fun StyledMediaSeekBar(
+    style: MediaSeekBarStyle,
+    artwork: Drawable?,
+    positionMs: Long,
+    durationMs: Long,
+    isPlaying: Boolean,
+    isScrubbing: Boolean,
+    modifier: Modifier = Modifier,
+    interactive: Boolean = false,
+    onScrubStart: () -> Unit = {},
+    onScrubStop: () -> Unit = {},
+    onSeek: (Long) -> Unit = {},
+    contentColor: Int? = null,
+) {
+    val currentOnSeek by rememberUpdatedState(onSeek)
+    val currentOnScrubStart by rememberUpdatedState(onScrubStart)
+    val currentOnScrubStop by rememberUpdatedState(onScrubStop)
+    key(style, interactive && durationMs > 0L) {
+        var isTrackingTouch by remember { mutableStateOf(false) }
+        AndroidView(
+            factory = { context ->
+                val bar =
+                    when (style) {
+                        MediaSeekBarStyle.GRADIENT_WAVE -> GradientWaveSeekBar(context)
+                        MediaSeekBarStyle.GLOWING -> GlowingSeekBar(context)
+                        MediaSeekBarStyle.COMET_TRAIL -> CometTrailSeekBar(context)
+                        MediaSeekBarStyle.COS -> CosSeekBar(context)
+                        MediaSeekBarStyle.WAVEFORM ->
+                            WaveformSeekBar(context).apply {
+                                followsMediaColors = false
+                                setWaveformColor(Color.WHITE)
+                                setThumbColor(Color.WHITE)
+                                setPadding(0, 0, 0, 0)
+                            }
+                        MediaSeekBarStyle.DEFAULT ->
+                            SeekBar(context, null, 0, R.style.MediaPlayer_ProgressBar).apply {
+                                (progressDrawable as? SquigglyProgress)?.apply {
+                                    waveLength =
+                                        resources.getDimension(
+                                            R.dimen.qs_media_seekbar_progress_wavelength
+                                        )
+                                    lineAmplitude =
+                                        resources.getDimension(
+                                            R.dimen.qs_media_seekbar_progress_amplitude
+                                        )
+                                    phaseSpeed =
+                                        resources.getDimension(
+                                            R.dimen.qs_media_seekbar_progress_phase
+                                        )
+                                    strokeWidth =
+                                        resources.getDimension(
+                                            R.dimen.qs_media_seekbar_progress_stroke_width
+                                        )
+                                }
+                            }
+                    }
+                bar.apply {
+                    layoutDirection = View.LAYOUT_DIRECTION_LTR
+                    setOnSeekBarChangeListener(
+                        object : SeekBar.OnSeekBarChangeListener {
+                            override fun onProgressChanged(
+                                bar: SeekBar,
+                                value: Int,
+                                fromUser: Boolean,
+                            ) {
+                                if (fromUser) currentOnSeek(value.toLong())
+                            }
+
+                            override fun onStartTrackingTouch(bar: SeekBar) {
+                                isTrackingTouch = true
+                                currentOnScrubStart()
+                            }
+
+                            override fun onStopTrackingTouch(bar: SeekBar) {
+                                currentOnScrubStop()
+                                isTrackingTouch = false
+                            }
+                        }
+                    )
+                }
+            },
+            update = { bar ->
+                contentColor?.let { color ->
+                    when (bar) {
+                        is GlowingSeekBar -> bar.setBarColor(color)
+                        is CometTrailSeekBar -> bar.setBarColor(color)
+                        is CosSeekBar -> bar.setBarColor(color)
+                        is GradientWaveSeekBar -> bar.setTrackColor(color)
+                        is WaveformSeekBar -> { bar.setWaveformColor(color); bar.setThumbColor(color) }
+                        else -> {
+                            bar.progressTintList = ColorStateList.valueOf(color)
+                            bar.thumbTintList = ColorStateList.valueOf(color)
+                            bar.progressBackgroundTintList = ColorStateList.valueOf((color and 0x00ffffff) or 0x33000000)
+                        }
+                    }
+                }
+                bar.max = durationMs.coerceIn(1L, Int.MAX_VALUE.toLong()).toInt()
+                if (!isTrackingTouch) {
+                    bar.progress = positionMs.coerceIn(0L, bar.max.toLong()).toInt()
+                }
+                bar.isEnabled = interactive && durationMs > 0L
+                when (bar) {
+                    is GradientWaveSeekBar -> {
+                        bar.setArtwork(artwork)
+                        bar.isScrubbing = isScrubbing || isTrackingTouch
+                        bar.setPlaybackState(isPlaying)
+                    }
+                    is GlowingSeekBar -> {
+                        bar.setArtwork(artwork)
+                        bar.isScrubbing = isScrubbing || isTrackingTouch
+                        bar.setPlaybackState(isPlaying)
+                    }
+                    is CometTrailSeekBar -> {
+                        bar.setArtwork(artwork)
+                        bar.isScrubbing = isScrubbing || isTrackingTouch
+                        bar.setPlaybackState(isPlaying)
+                    }
+                    is CosSeekBar -> {
+                        bar.setArtwork(artwork)
+                        bar.isScrubbing = isScrubbing || isTrackingTouch
+                        bar.setPlaybackState(isPlaying)
+                    }
+                    is WaveformSeekBar -> {
+                        if (isPlaying && !isScrubbing && !isTrackingTouch) {
+                            bar.startWaveAnimation()
+                        } else {
+                            bar.stopWaveAnimation()
+                        }
+                    }
+                }
+                (bar.progressDrawable as? SquigglyProgress)?.animate =
+                    isPlaying && !isScrubbing && !isTrackingTouch
+            },
+            onRelease = { bar ->
+                bar.setOnSeekBarChangeListener(null)
+                (bar as? GradientWaveSeekBar)?.setPlaybackState(false, animate = false)
+                (bar as? GlowingSeekBar)?.setPlaybackState(false, animate = false)
+                (bar as? CometTrailSeekBar)?.setPlaybackState(false, animate = false)
+                (bar as? CosSeekBar)?.setPlaybackState(false, animate = false)
+                (bar as? WaveformSeekBar)?.stopWaveAnimation()
+                (bar.progressDrawable as? SquigglyProgress)?.animate = false
+                if (isTrackingTouch) {
+                    bar.parent?.requestDisallowInterceptTouchEvent(false)
+                    currentOnScrubStop()
+                    isTrackingTouch = false
+                }
+            },
+            modifier = modifier,
+        )
+    }
+}
