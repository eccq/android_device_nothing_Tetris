+import com.android.systemui.common.shared.model.Icon
+
+/** Popup content for live scores surfaced in the dynamic island. */
+data class LiveScoreChipModel(
+    val key: String,
+    val icon: Icon?,
+    val appName: String,
+    val title: String?,
+    val score: String,
+    val subtitle: String?,
