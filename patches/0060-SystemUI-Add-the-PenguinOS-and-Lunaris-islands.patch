+        DisposableEffect(popupView) {
+            val root = popupView.rootView
+            val lp = root.layoutParams as? WindowManager.LayoutParams
+            if (lp != null && lp.layoutInDisplayCutoutMode != LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS) {
