+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.systemui.penguin.island
+
+import com.android.systemui.statusbar.chips.ui.model.MultipleOngoingActivityChipsModel
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.update
+
+/** What the island shows itself, so the stock status bar chips leave it out. */
+object IslandChipClaims {
+    data class Claims(
+        val notificationKeys: Set<String> = emptySet(),
+        val screenRecord: Boolean = false,
+    )
+
+    private val byIsland = MutableStateFlow<Map<String, Claims>>(emptyMap())
+    val claims: Flow<Claims> =
+        byIsland.map { all ->
+            Claims(
+                all.values.flatMap { it.notificationKeys }.toSet(),
+                all.values.any { it.screenRecord },
+            )
+        }
+
+    fun update(island: String, claims: Claims) {
+        byIsland.update { it + (island to claims) }
+    }
+
+    fun hide(chips: MultipleOngoingActivityChipsModel, claims: Claims) =
+        chips.copy(
+            active =
+                chips.active.map { chip ->
+                    val claimed =
+                        chip.key in claims.notificationKeys ||
+                            (claims.screenRecord && chip.key == SCREEN_RECORD_KEY)
+                    if (claimed) chip.copy(isHidden = true) else chip
+                }
+        )
+
+    private const val SCREEN_RECORD_KEY = "ScreenRecord"
+}
