+package com.android.systemui.lunaris.island.popups.ui.viewmodel
+
+import androidx.compose.runtime.snapshotFlow
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.dagger.qualifiers.Application
+import com.android.systemui.penguin.island.IslandChipClaims
+import javax.inject.Inject
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.launch
+
+@SysUISingleton
+class StatusBarPopupChipsViewModelStore
+@Inject
+constructor(
+    private val factory: StatusBarPopupChipsViewModel.Factory,
+    @Application private val applicationScope: CoroutineScope,
+) {
+    private val viewModels = mutableMapOf<Int, StatusBarPopupChipsViewModel>()
+
+    @Synchronized
+    fun forDisplay(displayId: Int): StatusBarPopupChipsViewModel {
+        return viewModels.getOrPut(displayId) {
+            factory.create().also { model ->
+                applicationScope.launch {
+                    try {
+                        coroutineScope {
+                            launch { model.activate() }
+                            snapshotFlow { model.islandClaims }.collect {
+                                IslandChipClaims.update("lunaris", it)
+                            }
+                        }
+                    } finally {
+                        IslandChipClaims.update("lunaris", IslandChipClaims.Claims())
+                    }
+                }
+            }
+        }
+    }
+}
