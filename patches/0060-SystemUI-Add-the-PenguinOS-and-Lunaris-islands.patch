+                        }
+                        launch { cardShiftX.animateTo(fromX, tween(400, easing = CosCardMove)) }
+                        launch { translationY.animateTo(fromY, tween(400, easing = CosCardMove)) }
+                        launch { reveal.animateTo(0f, tween(400, easing = CosCardEase)) }
+                        veil.animateTo(1f, tween(200, easing = CosCardEase))
+                    }
+                }
+                return@LaunchedEffect
+            }
+            if (isVisible && popupBoundsInScreen != null) {
+                scaleX.snapTo(initialScaleFromChip.x)
+                scaleY.snapTo(initialScaleFromChip.y)
+                alpha.snapTo(0f)
+                translationY.snapTo(-24f)
+                coroutineScope {
+                    launch {
+                        scaleX.animateTo(
+                            targetValue = 1f,
+                            animationSpec =
+                                spring(
+                                    dampingRatio = 0.72f,
+                                    stiffness = 520f,
+                                ),
+                        )
+                    }
+                    launch {
+                        scaleY.animateTo(
+                            targetValue = 1f,
+                            animationSpec =
+                                spring(
+                                    dampingRatio = 0.76f,
+                                    stiffness = 520f,
+                                ),
+                        )
+                    }
+                    launch {
+                        translationY.animateTo(
+                            targetValue = 0f,
+                            animationSpec =
+                                spring(
+                                    dampingRatio = 0.72f,
+                                    stiffness = 520f,
+                                ),
+                        )
+                    }
+                    launch {
+                        alpha.animateTo(
+                            1f,
+                            animationSpec = tween(190, easing = FastOutSlowInEasing),
+                        )
+                    }
+                }
+            } else if (!isVisible) {
+                if (skipMotionOnDismiss) {
+                    coroutineScope {
+                        launch {
+                            scaleX.animateTo(
+                                targetValue = 0.01f,
+                                animationSpec = tween(130),
+                            )
+                        }
+                        launch {
+                            scaleY.animateTo(
+                                targetValue = 0.01f,
+                                animationSpec = tween(130),
+                            )
+                        }
+                        launch { alpha.animateTo(0f, animationSpec = tween(120)) }
+                    }
+                } else {
+                    coroutineScope {
+                        launch {
+                            scaleX.animateTo(
+                                targetValue = initialScaleFromChip.x,
+                                animationSpec =
+                                    spring(
+                                        dampingRatio = 0.8f,
+                                        stiffness = Spring.StiffnessMediumLow,
+                                    ),
+                            )
+                        }
+                        launch {
+                            scaleY.animateTo(
+                                targetValue = initialScaleFromChip.y,
+                                animationSpec =
+                                    spring(
+                                        dampingRatio = 0.8f,
+                                        stiffness = Spring.StiffnessMediumLow,
+                                    ),
+                            )
+                        }
+                        launch {
+                            translationY.animateTo(-16f, animationSpec = spring(stiffness = Spring.StiffnessMedium))
+                        }
+                        launch { alpha.animateTo(0f, animationSpec = tween(160)) }
+                    }
+                }
+            }
+        }
+
+        DisposableEffect(popupView) {
+            val listener = ViewTreeObserver.OnWindowFocusChangeListener { hasFocus ->
+                if (!hasFocus) {
+                    viewModel.hidePopup()
+                }
+            }
+            popupView.viewTreeObserver.addOnWindowFocusChangeListener(listener)
+            onDispose {
+                popupView.viewTreeObserver.removeOnWindowFocusChangeListener(listener)
+            }
+        }
+
+        AnimatedVisibility(
+            visible = isVisible,
+            enter = if (cos) EnterTransition.None else fadeIn(animationSpec = tween(60)),
+            exit =
+                if (cos) fadeOut(tween(50, delayMillis = CosCardCloseMillis - 50))
+                else fadeOut(animationSpec = tween(160)),
+        ) {
+            val pagerScope = rememberCoroutineScope()
+            val pageFollow = remember { Animatable(0f) }
+            var pageAccumulator by remember { mutableFloatStateOf(0f) }
+            val pageThresholdPx = with(density) { 56.dp.toPx() }
+            val maxFollowPx = with(density) { 40.dp.toPx() }
+            val currentOnPage by rememberUpdatedState(onPage)
+
+            Box(
+                modifier =
+                    Modifier.padding(PopupEdgePadding)
+                        .wrapContentSize()
+                        .onGloballyPositioned { coordinates ->
+                            popupBoundsInScreen = coordinates.boundsInScreen(popupView)
+                        }
+                        .graphicsLayer {
+                            this.scaleX = scaleX.value
+                            this.scaleY = scaleY.value
+                            this.alpha = alpha.value
+                            this.translationY = translationY.value
+                            val radius = blur.value
+                            renderEffect =
+                                if (radius > 0.5f) BlurEffect(radius, radius, TileMode.Decal)
+                                else null
+                            if (cos) {
+                                this.translationX = cardShiftX.value
+                                this.transformOrigin =
+                                    if (stacked) TransformOrigin(0.5f, 0f) else TransformOrigin.Center
+                                val f = reveal.value
+                                this.clip = f < 1f
+                                if (this.clip) {
+                                    this.shape =
+                                        CosRevealShape(
+                                            f,
+                                            cosCornerPx,
+                                            anchorTop = stacked,
+                                            foldHeight =
+                                                if (stacked && !isVisible) stackTopCardHeight
+                                                else 0f,
+                                        )
+                                }
+                            } else {
+                                this.transformOrigin = transformOrigin
+                            }
+                        }
+                        .then(
+                            if (cos) {
+                                Modifier.drawWithContent {
+                                    drawContent()
+                                    val v = veil.value
+                                    if (v > 0f) {
+                                        if (stacked) {
+                                            // Only the top card comes out of the island; the
+                                            // rest slide out from under it.
+                                            drawRoundRect(
+                                                Color.Black,
+                                                size = Size(size.width, stackTopCardHeight),
+                                                cornerRadius = CornerRadius(cosCornerPx),
+                                                alpha = v,
+                                            )
+                                        } else {
+                                            drawRect(Color.Black, alpha = v)
+                                        }
+                                    }
+                                }
+                            } else {
+                                Modifier
+                            }
+                        )
+            ) {
+                Box(
+                    modifier =
+                        Modifier.then(
+                                if (canPage) {
+                                    Modifier.pointerInput(canPage) {
+                                        detectHorizontalDragGestures(
+                                            onDragEnd = {
+                                                val direction =
+                                                    when {
+                                                        pageAccumulator <= -pageThresholdPx -> 1
+                                                        pageAccumulator >= pageThresholdPx -> -1
+                                                        else -> 0
+                                                    }
+                                                pageAccumulator = 0f
+                                                pagerScope.launch {
+                                                    pageFollow.animateTo(
+                                                        0f,
+                                                        spring(
+                                                            dampingRatio =
+                                                                Spring.DampingRatioNoBouncy,
+                                                            stiffness = Spring.StiffnessMedium,
+                                                        ),
+                                                    )
+                                                }
+                                                if (direction != 0) {
+                                                    currentOnPage(direction)
+                                                }
+                                            },
+                                            onDragCancel = {
+                                                pageAccumulator = 0f
+                                                pagerScope.launch {
+                                                    pageFollow.animateTo(
+                                                        0f,
+                                                        spring(
+                                                            dampingRatio =
+                                                                Spring.DampingRatioMediumBouncy,
+                                                            stiffness = Spring.StiffnessMedium,
+                                                        ),
+                                                    )
+                                                }
+                                            },
+                                            onHorizontalDrag = { change, dragAmount ->
+                                                pageAccumulator += dragAmount
+                                                val target =
+                                                    (pageAccumulator * 0.5f)
+                                                        .coerceIn(-maxFollowPx, maxFollowPx)
+                                                pagerScope.launch { pageFollow.snapTo(target) }
+                                                change.consume()
+                                            },
+                                        )
+                                    }
+                                } else {
+                                    Modifier
+                                }
+                            )
+                            .graphicsLayer { translationX = pageFollow.value }
+                ) {
+                    if (stackedChips != null) {
+                        CompositionLocalProvider(LocalIslandGlassAlpha provides glassAlpha) {
+                            IslandCardStack(
+                                chips = stackedChips,
+                                isVisible = isVisible,
+                                onTopCardHeight = { stackTopCardHeight = it },
+                            )
+                        }
+                        return@Box
+                    }
+                    AnimatedContent(
+                        targetState = viewModel,
+                        contentAlignment = Alignment.TopCenter,
+                        contentKey = { it.chipId },
+                        transitionSpec = {
+                            val dir = if (pageDirection >= 0) 1 else -1
+                            (slideInHorizontally(animationSpec = tween(280)) { w -> dir * w } +
+                                fadeIn(animationSpec = tween(200))) togetherWith
+                                (slideOutHorizontally(animationSpec = tween(240)) { w -> -dir * w } +
+                                    fadeOut(animationSpec = tween(140))) using
+                                SizeTransform(clip = false) { _, _ ->
+                                    spring(dampingRatio = 0.9f, stiffness = 380f)
+                                }
+                        },
+                        label = "island_popup_pager",
+                    ) { chip ->
+                        CompositionLocalProvider(LocalIslandGlassAlpha provides glassAlpha) {
+                            IslandPopupContent(chip)
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
