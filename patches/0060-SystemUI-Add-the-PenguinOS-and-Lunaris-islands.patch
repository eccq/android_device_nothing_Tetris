+    private fun handleCallNotification(sbn: StatusBarNotification, extras: Bundle) {
+        val callerName = extras.getString("android.title")
+        val number = extras.getString("android.text")
+        val callerPhoto =
+            try {
+                sbn.notification?.getLargeIcon()?.loadDrawable(context)
+            } catch (_: Exception) {
+                null
+            }
+
+        val allActions = sbn.notification?.actions ?: emptyArray()
+        val actions =
+            (callStyleActions(extras) + allActions)
+                .filter { a -> a.remoteInputs.isNullOrEmpty() && a.actionIntent != null }
+                .take(3)
+                .mapNotNull { a ->
+                    a.title?.let { IslandEvent.NotificationAction(label = it, action = a) }
+                }
+
+        val androidCallType = extras.getInt(
+            Notification.EXTRA_CALL_TYPE,
+            Notification.CallStyle.CALL_TYPE_UNKNOWN,
+        )
+        val callType =
+            if (androidCallType == Notification.CallStyle.CALL_TYPE_INCOMING)
+                "Phone:incoming"
+            else "Phone:active"
+
+        val icon =
+            try {
+                context.packageManager.getApplicationIcon(sbn.packageName)
+            } catch (_: Exception) {
+                null
+            }
+
+        val callWhen = sbn.notification?.`when` ?: 0L
+        val connected =
+            callType == "Phone:active" && extras.getBoolean(Notification.EXTRA_SHOW_CHRONOMETER)
+        val previousCall = _callEvents.value.firstOrNull { it.sbn.key == sbn.key }
+        val callStart = when {
+            connected && callWhen > 0L -> callWhen
+            previousCall?.callType == callType && previousCall.connected == connected ->
+                previousCall.callStartTimeMs
+            else -> System.currentTimeMillis()
+        }
+
+        val event =
+            IslandEvent.Call(
+                sbn = sbn,
+                callerName = callerName,
+                number = number,
+                appIcon = icon,
+                callerPhoto = callerPhoto,
+                callType = callType,
+                callStartTimeMs = callStart,
+                actions = actions,
+                connected = connected,
+                controls = callControls(extras, allActions),
+            )
+
+        val current = _callEvents.value.toMutableList()
+        current.removeAll { it.sbn.key == sbn.key }
+        current.add(0, event)
+        _callEvents.value = current
+    }
+
+    /** The call buttons, with the dialer's speaker and mute toggles and their current state. */
+    private fun callControls(
+        extras: Bundle,
+        actions: Array<Notification.Action>,
+    ): IslandEvent.CallControls {
+        fun pending(key: String) = extras.getParcelable(key, PendingIntent::class.java)
+        val byIntent = actions.associateBy { actionIntentString(it) }
+        val speakerOff = byIntent[DIALER_SPEAKER_OFF]
+        val speakerOn = byIntent[DIALER_SPEAKER_ON]
+        val unmute = byIntent[DIALER_UNMUTE]
+        val mute = byIntent[DIALER_MUTE]
+        return IslandEvent.CallControls(
+            answer = pending(Notification.EXTRA_ANSWER_INTENT),
+            decline = pending(Notification.EXTRA_DECLINE_INTENT),
+            hangUp = pending(Notification.EXTRA_HANG_UP_INTENT),
+            speakerOn = if (speakerOff != null) true else if (speakerOn != null) false else null,
+            speaker = (speakerOff ?: speakerOn)?.actionIntent,
+            muted = if (unmute != null) true else if (mute != null) false else null,
+            mute = (unmute ?: mute)?.actionIntent,
+        )
+    }
+
+    /** CallStyle keeps its answer, decline and hang up buttons in extras, not in its actions. */
+    private fun callStyleActions(extras: Bundle): List<Notification.Action> =
+        listOf(
+                Notification.EXTRA_DECLINE_INTENT to
+                    (com.android.internal.R.string.call_notification_decline_action to
+                        com.android.internal.R.drawable.ic_call_decline),
+                Notification.EXTRA_HANG_UP_INTENT to
+                    (com.android.internal.R.string.call_notification_hang_up_action to
+                        com.android.internal.R.drawable.ic_call_decline),
+                Notification.EXTRA_ANSWER_INTENT to
+                    (com.android.internal.R.string.call_notification_answer_action to
+                        com.android.internal.R.drawable.ic_call_answer),
+            )
+            .mapNotNull { (key, button) ->
+                val intent =
+                    extras.getParcelable(key, PendingIntent::class.java) ?: return@mapNotNull null
+                Notification.Action.Builder(
+                        Icon.createWithResource("android", button.second),
+                        context.getString(button.first),
+                        intent,
+                    )
+                    .build()
+            }
