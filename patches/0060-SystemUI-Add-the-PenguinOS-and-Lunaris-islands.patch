+        invalidate()
+    }
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        val width = resolveSize(dp(420f), widthMeasureSpec)
+        val textWidth = (width - dp(148f)).coerceAtLeast(1)
