@@ -0,0 +1,41 @@
+package com.android.systemui.lunaris.island.popups.shared
+
+import com.android.systemui.lunaris.island.events.model.IslandEvent
+
+/** Each event has its own System setting and source filter. */
+enum class SystemEventFeature(
+    val settingKey: String,
+    val notificationType: String? = null,
+    val defaultOn: Boolean = false,
+) {
+    BATTERY(DynamicIslandFeatureSettings.BATTERY, defaultOn = true),
+    UNLOCK(DynamicIslandFeatureSettings.UNLOCK),
+    BLUETOOTH(DynamicIslandFeatureSettings.BLUETOOTH, defaultOn = true),
+    CALLS(DynamicIslandFeatureSettings.CALLS, "call", defaultOn = true),
+    NOTIFICATIONS(DynamicIslandFeatureSettings.NOTIFICATIONS, "notification"),
+    ONGOING_ACTIVITIES(DynamicIslandFeatureSettings.ONGOING_ACTIVITIES, "promoted_ongoing", defaultOn = true),
+    HOTSPOT(DynamicIslandFeatureSettings.HOTSPOT, defaultOn = true),
+    VPN(DynamicIslandFeatureSettings.VPN),
+    RINGER(DynamicIslandFeatureSettings.RINGER, defaultOn = true),
+    TIMER(DynamicIslandFeatureSettings.TIMER, "timer", defaultOn = true),
+    AUDIO_RECORDING(DynamicIslandFeatureSettings.AUDIO_RECORDING, "audio_recording", defaultOn = true),
+    NOW_PLAYING(DynamicIslandFeatureSettings.NOW_PLAYING, "now_playing");
+
+    companion object {
+        fun forEvent(event: IslandEvent): SystemEventFeature? = when (event) {
+            is IslandEvent.Charging -> BATTERY
+            is IslandEvent.BiometricUnlock -> UNLOCK
+            is IslandEvent.Bluetooth -> BLUETOOTH
+            is IslandEvent.Call -> CALLS
+            is IslandEvent.Notification -> NOTIFICATIONS
+            is IslandEvent.PromotedOngoing -> ONGOING_ACTIVITIES
+            is IslandEvent.Hotspot -> HOTSPOT
+            is IslandEvent.Vpn -> VPN
+            is IslandEvent.RingerMode -> RINGER
+            is IslandEvent.Timer -> TIMER
+            is IslandEvent.AudioRecording -> AUDIO_RECORDING
+            is IslandEvent.NowPlaying -> NOW_PLAYING
+            else -> null
+        }
+    }
+}
