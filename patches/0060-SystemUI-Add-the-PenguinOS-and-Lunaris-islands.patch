index 000000000000..9173668fd217
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/penguin/island/light/LightShaders.kt
@@ -0,0 +1,83 @@
+/*
+ * Copyright (C) 2026 The PenguinOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.systemui.penguin.island.light
+
+internal object LightShaders {
+    const val ROUNDED_BOX =
+        """
+        float roundedBox(float2 p, float2 extent, float r) {
+            float2 q = abs(p) - extent + r;
+            return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
+        }
+        """
+
+    const val CAPSULE =
+        """
+        float softAbs(float x, float k) {
+            return sqrt(x * x + k * k);
+        }
+
+        float softMax(float a, float b, float k) {
+            float d = a - b;
+            return 0.5 * (a + b + sqrt(d * d + k * k));
+        }
+
+        float capsule(float2 p, float2 extent) {
+            bool tall = extent.x < extent.y;
+            float2 e = tall ? extent.yx : extent;
+            float2 q = tall ? p.yx : p;
+            q = float2(softAbs(q.x, 1.0), softAbs(q.y, 1.0));
+            float r = e.y;
+            float straight = max(e.x - r, 0.0);
+            float scale = r / 80.0;
+            float s = q.x - straight;
+            float hard = max(s, 0.0);
+            float soft = softMax(s, 0.0, 26.6 * scale);
+            float alongEnd = 1.0 - smoothstep(0.0, max(70.0 * scale, 1e-3), abs(s));
+            float acrossEnd = smoothstep(r - max(60.0 * scale, 1e-3), r, q.y);
+            float x = mix(hard, soft, clamp(alongEnd * acrossEnd, 0.0, 1.0));
+            return length(float2(x, q.y)) - r;
+        }
+        """
+
+    const val PERIMETER_LIGHT =
+        """
+        float2 perimeterLight(float2 pos, float2 extent, float d, float turn, float4 bands,
+                float4 spread, float curve, float curveMix) {
+            float perimeter = (extent.x + extent.y) * 2.0;
+            float lightAt = mod(turn + extent.x / perimeter * 0.5 + 0.5, 1.0);
+            float2 dir = normalize(pos);
+            float2 dirAbs = abs(dir);
+            float2 onBox =
+                min(dirAbs.xy * extent.yx / max(float2(0.001), dirAbs.yx), extent) * sign(dir);
+            float side = (lightAt <= 0.5 ? 1.0 : -1.0) * dot(float2(-extent.y, extent.x), onBox);
+            float lightDistance = perimeter * min(lightAt, 1.0 - lightAt) * 2.0;
+            float2 fromCorner = abs(onBox - extent);
+            float here = fromCorner.x + fromCorner.y;
+            float toNear = side >= 0.0 ? abs(lightDistance - here) : lightDistance + here;
+            toNear = min(2.0 * perimeter - toNear, toNear);
+
+            float near = smoothstep(spread.y * perimeter, spread.x * perimeter, toNear);
+            float far = smoothstep(spread.w * perimeter, spread.z * perimeter, perimeter - toNear);
+            float nearBand = smoothstep(-bands.y, -bands.x, d);
+            float farBand = smoothstep(-bands.w, -bands.z, d);
+            if (curveMix > 0.001) {
+                nearBand = mix(nearBand, pow(nearBand, curve), curveMix);
+                farBand = mix(farBand, pow(farBand, curve), curveMix);
+            }
+            return float2(near * nearBand, far * farBand);
+        }
+        """
+
+    const val SOFT_LIGHT =
+        """
+        float softLight(float a, float b) {
+            return a <= 0.5
+                ? b - (1.0 - 2.0 * a) * b * (1.0 - b)
+                : b + (2.0 * a - 1.0) * (sqrt(b) - b);
+        }
+        """
+}
diff --git a/packages/SystemUI/src/com/android/systemui/penguin/island/light/SeekLight.kt b/packages/SystemUI/src/com/android/systemui/penguin/island/light/SeekLight.kt
new file mode 100644
index 000000000000..e4199fbf2b44
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/penguin/island/light/SeekLight.kt
@@ -0,0 +1,144 @@
+/*
+ * Copyright (C) 2026 The PenguinOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.systemui.penguin.island.light
+
+import android.graphics.BlendMode
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RuntimeShader
+
+class SeekLight {
+    data class Shape(
+        val height: Float,
+        val heightFalloff: Float,
+        val coneK: Float,
+        val secondConeK: Float,
+        val w0: Float,
+        val alpha1: Float,
+        val alpha2: Float,
+    )
+
+    private val shader = RuntimeShader(SOURCE)
+    private val paint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            shader = this@SeekLight.shader
+            blendMode = BlendMode.SCREEN
+        }
+    private var height = 0.1f
+    private var heightFalloff = 0f
+
+    init {
+        shader.setFloatUniform("uFalloff", AXIAL_FALLOFF, RADIAL_FALLOFF)
+        setColor(Color.WHITE)
+        setShape(Shape(0.1f, 0f, 0f, 0f, 0.008f, 0f, 0f))
+    }
+
+    fun setColor(color: Int) {
+        shader.setFloatUniform(
+            "uColor",
+            Color.red(color) / 255f,
+            Color.green(color) / 255f,
+            Color.blue(color) / 255f,
+        )
+    }
+
+    fun setShape(shape: Shape) {
+        height = shape.height
+        heightFalloff = shape.heightFalloff
+        shader.setFloatUniform("uCones", shape.coneK, shape.secondConeK)
+        shader.setFloatUniform("uAlphas", shape.alpha1, shape.alpha2)
+        shader.setFloatUniform("uHeadWidth", shape.w0)
+    }
+
+    fun draw(
+        canvas: Canvas,
+        trackStart: Float,
+        centerY: Float,
+        length: Float,
+        fraction: Float,
+        rtl: Boolean,
+    ) {
+        if (length <= 0f) return
+        val grown = if (fraction <= GROW_UNTIL) (fraction / (GROW_UNTIL + 0.01f)).coerceIn(0f, 1f) else 1f
+        val width = PADDING * 2f + length
+        shader.setFloatUniform("uSize", width, LIGHT_HEIGHT)
+        shader.setFloatUniform("uTrack", fraction, length)
+        shader.setFloatUniform("uReach", height * grown, heightFalloff * grown)
+        shader.setFloatUniform("uRtl", if (rtl) 1f else 0f)
+        val save = canvas.save()
+        canvas.translate(trackStart - PADDING, centerY - LIGHT_HEIGHT / 2f)
+        canvas.drawRect(0f, 0f, width, LIGHT_HEIGHT, paint)
+        canvas.restoreToCount(save)
+    }
+
+    private companion object {
+        const val LIGHT_HEIGHT = 450f
+        const val PADDING = 300f
+        const val GROW_UNTIL = 0.2f
+        const val SPOT_RADIUS = 500f
+        const val AXIAL_FALLOFF = 2f
+        const val RADIAL_FALLOFF = 1f
+
+        val SOURCE =
+            """
+            uniform float2 uSize;
+            uniform float2 uTrack;
+            uniform float2 uReach;
+            uniform float2 uCones;
+            uniform float2 uAlphas;
+            uniform float uHeadWidth;
+            uniform float2 uFalloff;
+            uniform float uRtl;
+            uniform float3 uColor;
+
+            const float SPOT = $SPOT_RADIUS;
+
+            float4 cone(float2 q, float opening, float strength) {
+                float behind = max(-q.x, 0.0);
+                float halfWidth = opening * behind + uHeadWidth * SPOT;
+                float across = abs(q.y);
+                float edge = 1.0 - smoothstep(0.0, SPOT * 2.0, across - halfWidth);
+                float radial = exp(-uFalloff.y * pow(across / (halfWidth + 1e-4), 2.0));
+                float axial = exp(-uFalloff.x * behind / SPOT);
+
+                float reach = SPOT * uReach.x;
+                float reached = clamp(behind / (reach + 1e-4), 0.0, 1.0);
+                float height = 1.0 - pow(reached, uReach.y);
+                height *= exp(-(behind >= reach ? (behind - reach) / SPOT : 0.0) * 3.0);
+
+                float light = edge * radial * height * axial * smoothstep(0.0, 0.03 * SPOT, behind);
+                return float4(uColor * light, light * strength);
+            }
+
+            half4 main(float2 xy) {
+                float2 pos = xy - uSize * 0.5;
+                float2 q = pos - float2((uTrack.x - 0.5) * uTrack.y, 0.0);
+                q.x *= 1.0 - 2.0 * uRtl;
+                if (q.x >= 0.0) {
+                    return half4(0.0);
+                }
+
+                float4 first = cone(q, uCones.x, uAlphas.x);
+                float4 second = cone(q, uCones.y, uAlphas.y);
+                float4 both = float4(0.0);
+                both.rgb = min(float3(1.0), first.rgb + second.rgb);
+                both.a = first.a * (1.0 - second.a) + second.a;
+                if (both.a <= 0.0) {
+                    return half4(0.0);
+                }
+                float lean = abs(second.a - first.a) / both.a;
+                both.rgb = mix(both.rgb, first.rgb, (second.a <= first.a ? 1.0 : 0.0) * lean);
+                both.rgb = mix(both.rgb, second.rgb, (first.a <= second.a ? 1.0 : 0.0) * lean);
+
+                both.rgb = clamp(both.rgb, 0.0, 1.0);
+                both.a = clamp(max(both.a, max(max(both.r, both.g), both.b)), 0.0, 1.0);
+                return half4(both);
+            }
+            """
+                .trimIndent()
+    }
+}
