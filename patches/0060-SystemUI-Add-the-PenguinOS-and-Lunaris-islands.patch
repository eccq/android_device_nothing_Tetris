+    fun startListening() {}
+
+    fun stopListening() {
+        _sportsEvents.value = emptyList()
+        _nowPlayingEvent.value = null
+    }
+
+    fun clearSportsEvent(key: String) {
+        _sportsEvents.value = _sportsEvents.value.filter { it.key != key }
+    }
+}
