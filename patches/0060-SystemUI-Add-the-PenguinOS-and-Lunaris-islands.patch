+@Composable
+private fun LunarisBarPositionedContent(
+    cutoutSpec: DynamicIslandCutoutSpec,
+    alignment: LunarisBarAlignment,
+    settings: LunarisBarSettings,
+    hostLeft: Float,
+    content: @Composable () -> Unit,
+) {
+    Layout(content = content) { measurables, constraints ->
+        val windowWidth =
+            cutoutSpec.windowWidthPx.takeIf { it > 0 }?.toFloat() ?: constraints.maxWidth.toFloat()
+        val camera = cutoutSpec.cutoutBounds
+        val margin = (if (camera != null) 4.dp else 12.dp).toPx()
+        val padding = (5.dp * settings.miniScale).toPx()
+        val gap = cutoutSpec.embeddedGapWidth.toPx()
+        val offset = settings.offsetX.dp.toPx()
+        val edge =
+            lunarisBarChipLeft(
+                alignment,
+                windowWidth,
+                0f,
+                camera?.center?.x,
+                gap,
+                padding,
+                offset,
+                margin,
+            )
+        val availableWidth =
+            when (alignment) {
+                    LunarisBarAlignment.LEFT -> windowWidth - margin - edge
+                    LunarisBarAlignment.RIGHT -> edge - margin
+                    LunarisBarAlignment.CENTER -> windowWidth - 2f * margin
+                }
+                .roundToInt()
+                .coerceIn(1, constraints.maxWidth.coerceAtLeast(1))
+        val placeable =
+            measurables.single().measure(constraints.copy(minWidth = 0, maxWidth = availableWidth))
+        val left =
+            lunarisBarChipLeft(
+                alignment,
+                windowWidth,
+                placeable.width.toFloat(),
+                camera?.center?.x,
+                gap,
+                padding,
+                offset,
+                margin,
+            )
+        layout(constraints.maxWidth, placeable.height) {
+            placeable.place((left - hostLeft).roundToInt(), settings.offsetY.dp.roundToPx())
+        }
+    }
+}
+
+@Composable
+private fun rememberLunarisBarMediaTransitionSquish(
+    trigger: Int,
+    settings: LunarisBarSettings,
+): State<Float> {
+    val squish = remember { Animatable(0f, visibilityThreshold = 0.005f) }
+    var lastTrigger by remember { mutableIntStateOf(0) }
+    val speed = settings.animationSpeed.coerceAtLeast(0.1f)
+    LaunchedEffect(trigger, settings.isReducedMotion, speed, settings.bounce) {
+        val shouldAnimate = trigger != 0 && trigger != lastTrigger
+        lastTrigger = trigger
+        if (!shouldAnimate || settings.isReducedMotion || !ValueAnimator.areAnimatorsEnabled()) {
+            squish.snapTo(0f)
+            return@LaunchedEffect
+        }
+        val rebound =
+            when (settings.bounce) {
+                0 -> 0f
+                2 -> -0.5f
+                else -> -1f / 3f
+            }
+        squish.animateTo(
+            targetValue = 0f,
+            animationSpec =
+                keyframes {
+                    durationMillis = (650 / speed).toInt()
+                    0f at 0 using FastOutSlowInEasing
+                    1f at (190 / speed).toInt() using FastOutSlowInEasing
+                    rebound at (400 / speed).toInt() using FastOutSlowInEasing
+                    0f at (650 / speed).toInt()
+                },
+        )
+    }
+    return squish.asState()
+}
