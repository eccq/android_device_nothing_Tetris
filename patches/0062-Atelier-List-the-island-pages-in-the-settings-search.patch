+
+package com.crdroid.settings.fragments.statusbar.lunaris
+
+import android.content.Context
+import com.android.settings.R
+import com.android.settings.core.PreferenceXmlParserUtils
+import com.android.settings.core.PreferenceXmlParserUtils.MetadataFlag
+import com.android.settings.search.BaseSearchIndexProvider
+import com.android.settingslib.search.SearchIndexableRaw
+import com.crdroid.settings.fragments.statusbar.DynamicIslandSettings
+
+/** Lists a Lunaris page in the search, only while the Lunaris island is on. */
+class LunarisBarSearchProvider(private val pageRes: Int) : BaseSearchIndexProvider() {
+    override fun isPageSearchEnabled(context: Context) = DynamicIslandSettings.isLunaris(context)
+
+    // Search turns keys on and off for the whole Settings app, so these get a prefix of their own.
+    override fun getRawDataToIndex(context: Context, enabled: Boolean): List<SearchIndexableRaw> {
+        val listed = metadata(context, R.xml.dynamic_island_settings)
+            .mapNotNull { it.getString(PreferenceXmlParserUtils.METADATA_KEY) }
+            .minus(DynamicIslandSettings.PENGUIN_KEYS)
+        val page = metadata(context, pageRes)
+        val pageTitle = page.first().getString(PreferenceXmlParserUtils.METADATA_TITLE)
+        return page.drop(1).mapNotNull {
+            val key = it.getString(PreferenceXmlParserUtils.METADATA_KEY)
+            val title = it.getString(PreferenceXmlParserUtils.METADATA_TITLE)
+            val type = it.getString(PreferenceXmlParserUtils.METADATA_PREF_TYPE)
+            if (key == null || title == null || key in listed || key == "cards_empty" ||
+                type == "PreferenceCategory") return@mapNotNull null
+            SearchIndexableRaw(context).apply {
+                this.key = KEY_PREFIX + key
+                this.title = title
+                screenTitle = pageTitle
+            }
+        }
+    }
+
+    private fun metadata(context: Context, xmlRes: Int) =
+        PreferenceXmlParserUtils.extractMetadata(context, xmlRes,
+            MetadataFlag.FLAG_INCLUDE_PREF_SCREEN or MetadataFlag.FLAG_NEED_KEY or
+                MetadataFlag.FLAG_NEED_PREF_TYPE or MetadataFlag.FLAG_NEED_PREF_TITLE)
+
+    companion object {
+        const val KEY_PREFIX = "lunaris_search_"
+    }
+}
