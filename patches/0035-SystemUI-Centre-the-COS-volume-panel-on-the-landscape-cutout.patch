+    /**
+     * In landscape the COS column (ringer, slider, expand button and app sliders) centres on
+     * the side punch hole, or on the screen without one.
+     */
+    private fun centerOnCutout(root: View) {
+        if (root.resources.configuration.orientation != Configuration.ORIENTATION_LANDSCAPE) {
+            root.translationY = 0f
+            return
+        }
+        val parts =
+            listOf(
+                    R.id.volume_dialog_top_section_container,
+                    R.id.volume_dialog_main_slider_container,
+                    R.id.volume_dialog_bottom_section_container,
+                )
+                .mapNotNull { id ->
+                    root.findViewById<View>(id)?.takeIf {
+                        it.visibility == View.VISIBLE && it.height > 0
+                    }
+                }
+        if (parts.isEmpty()) return
+        val top = parts.minOf { it.top }
+        val bottom = parts.maxOf { it.bottom }
+        val loc = IntArray(2)
+        root.getLocationInWindow(loc)
+        val rootTop = loc[1] - root.translationY
+        val windowHeight = root.rootView.height
+        val cutout =
+            root.rootWindowInsets?.displayCutout?.boundingRects?.firstOrNull {
+                !it.isEmpty && it.top > 0
+            }
+        val target = cutout?.exactCenterY() ?: (windowHeight / 2f)
+        val shift = target - (rootTop + (top + bottom) / 2f)
+        // Never past the window edges.
+        root.translationY =
+            shift.coerceIn(-(rootTop + top), windowHeight - (rootTop + bottom))
     }
 
