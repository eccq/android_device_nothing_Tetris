@@ -311,14 +311,20 @@ class LockScreenGalleryActivity : ComponentActivity() {
     }
 
     /**
-     * The first time, the wallpaper already on the lock screen becomes the first saved lock
-     * screen, so the switcher never starts empty.
+     * The wallpaper on the lock screen becomes a saved lock screen the first time, and again
+     * whenever it was changed outside this app, so applying a clock never brings back an old one.
      */
     private fun adoptCurrentWallpaper(store: GalleryStore) {
-        if (store.lockScreens.isNotEmpty()) return
         val wm = WallpaperManager.getInstance(this)
+        val deviceId = GalleryApplier.lockWallpaperId(wm)
+        val first = store.lockScreens.isEmpty()
+        if (!first && deviceId == store.deviceWallpaperId) return
+        // getDrawable(FLAG_LOCK) is null while the lock screen shares the home wallpaper.
         val drawable = runCatching { wm.getDrawable(WallpaperManager.FLAG_LOCK) }.getOrNull()
-            ?: runCatching { wm.builtInDrawable }.getOrNull() ?: return
+            ?: runCatching { wm.getDrawable(WallpaperManager.FLAG_SYSTEM) }.getOrNull()
+            ?: if (first) runCatching { wm.builtInDrawable }.getOrNull() else null
+        store.deviceWallpaperId = deviceId
+        if (drawable == null) return
         val (w, h) = GalleryApplier.screenSize(this)
         val bitmap = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
         drawable.setBounds(0, 0, w, h)
